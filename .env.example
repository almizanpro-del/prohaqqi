# Copy to .env.local and fill in. The app runs WITHOUT these (demo mode,
# in-memory data + simulated auth/payments) — required for production.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). Enables real auth (email verification),
# persistence, and payment records.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Keep secret — used by API routes, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# CliQ payment details shown on /pay. Leave empty until your official
# account details are confirmed — the page then shows a "not configured" note.
NEXT_PUBLIC_CLIQ_ALIAS=
NEXT_PUBLIC_CLIQ_IBAN=

# Official support/contact email (shown where needed once published).
NEXT_PUBLIC_SUPPORT_EMAIL=
